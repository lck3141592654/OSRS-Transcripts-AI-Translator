# ═══════════════════════════════════════════
#  多 API 配置範例
# ═══════════════════════════════════════════
#
# 支援多個 API Key 同時工作，分為主 API（付費）和副 API（免費）。
# 並發上限繼承規則：
#   有 APIx_PARALLEL_LIMIT → 用獨立值
#   無，且 TYPE=main      → 用硬編碼預設 10
#   無，且 TYPE=fallback   → 用硬編碼預設 1
#
# 429 冷卻策略：
#   每次 429 都重新冷卻 60 秒（每次都會重新計時）
#   累計達門檻才永久停用該 API（預設 2 次；只剩一個可用 API 時放寬為 5 次，其他 API 回來即恢復原值）
#
# API 編號可跳號（例如只有 API1_、API3_）；只要有任何 APIx_ 能成功解析就使用多 API 格式
# 若沒有任何 APIx_ 能成功解析（缺 TYPE／API_KEY／MODEL／BASE_URL），才回退讀取舊版單一 API 格式
#
# ═══════════════════════════════════════════
#  主 API（付費，預設並發 = 10）
# ═══════════════════════════════════════════

# ── API 1：主 API，無獨立並發限制（採用預設 10） ──
API1_TYPE=main
API1_MODEL_PROVIDER=openrouter
API1_MODEL=deepseek/deepseek-v4-flash
API1_API_KEY=sk-Your API Key 1
API1_BASE_URL=https://openrouter.ai/api/v1

# ── API 2：主 API，獨立設定並發為 8 ──
API2_TYPE=main
API2_PARALLEL_LIMIT=8
API2_MODEL_PROVIDER=openrouter
API2_MODEL=google/gemini-2.5-flash
API2_API_KEY=sk-Your API Key 2
API2_BASE_URL=https://openrouter.ai/api/v1

# ── API 3：主 API，並發 = 5（比預設 10 更保守） ──
API3_TYPE=main
API3_PARALLEL_LIMIT=5
API3_MODEL_PROVIDER=openrouter
API3_MODEL=qwen/qwen-3
API3_API_KEY=sk-Your API Key 3
API3_BASE_URL=https://openrouter.ai/api/v1


# ═══════════════════════════════════════════
#  副 API（免費，預設並發 = 1）
# ═══════════════════════════════════════════

# ── API 4：副 API，無獨立並發（採用預設 1） ──
API4_TYPE=fallback
API4_MODEL_PROVIDER=deepseek
API4_MODEL=deepseek-chat
API4_API_KEY=sk-Your Free API Key 4
API4_BASE_URL=https://api.deepseek.com/v1

# ── API 5：副 API，並發 = 1（限制更嚴） ──
API5_TYPE=fallback
API5_PARALLEL_LIMIT=1
API5_MODEL_PROVIDER=openrouter
API5_MODEL=google/gemini-2.5-flash-lite
API5_API_KEY=sk-Your Free API Key 5
API5_BASE_URL=https://openrouter.ai/api/v1


# ═══════════════════════════════════════════
#  舊版單一 API 格式（向後相容）
#  僅在沒有任何 APIx_ 能成功解析時才會讀取
# ═══════════════════════════════════════════

# API_KEY=sk-Your API Key
# MODEL_PROVIDER=openrouter
# MODEL=deepseek/deepseek-v4-flash
# BASE_URL=https://openrouter.ai/api/v1